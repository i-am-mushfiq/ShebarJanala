{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "shebar-janala",
	"compatibility_date": "2026-08-20",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "shebar-janala"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	// Non-secret demo-mode flags, matching .env.local's local defaults so the
	// deployed app behaves the same way already verified locally throughout
	// this project. Actual secrets (DATABASE_URL, JWT_SECRET, ...) are set via
	// `wrangler secret put`, not here — this file is committed to git.
	"vars": {
		"AI_PROVIDER": "deepseek",
		"DEEPSEEK_MODEL": "deepseek-v4-flash",
		"DEEPSEEK_BASE_URL": "https://api.deepseek.com/v1",
		"DEEPSEEK_THINKING": "disabled",
		"OTP_DEV_ECHO": "false",
		"SMS_PROVIDER": "demo",
		"VISION_MODERATION_PROVIDER": "demo"
	}
}
