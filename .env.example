####################################################################
# Shebar Janala — environment configuration
#
# Copy to `.env.local` and fill in. EVERY variable here has a working
# default except the AI keys, so the app runs end-to-end with zero
# configuration; the AI layer then reports itself as "Simulated".
####################################################################

# ---------------------------------------------------------------
# Database (PRD §87 DATABASE_URL)
# libSQL / SQLite file. Point at a Turso URL for a hosted database.
# ---------------------------------------------------------------
DATABASE_URL="file:./data/shebar-janala.db"
# DATABASE_AUTH_TOKEN=""   # only for remote (Turso) libSQL

# ---------------------------------------------------------------
# Auth (PRD §87 JWT_SECRET / JWT_REFRESH_SECRET)
# MUST be replaced in any shared environment. Minimum 32 chars.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------
JWT_SECRET="dev-only-access-secret-change-me-0000000000000000"
JWT_REFRESH_SECRET="dev-only-refresh-secret-change-me-000000000000000"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="30d"

# ---------------------------------------------------------------
# AI provider — OPTIONAL.
# Leave ALL keys blank to run the deterministic engine. The UI shows a
# visible "Simulated AI" badge whenever no key is present; it is never
# silently faked.
#
# With several keys present the order is anthropic → openai → deepseek.
# Set AI_PROVIDER to choose explicitly instead of relying on that order.
# Verify whatever you set with:  npm run ai:check
# ---------------------------------------------------------------
# AI_PROVIDER="deepseek"        # anthropic | openai | deepseek | simulated

ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""
# DEEPSEEK_API_KEY="sk-..."

# Model ids. Defaults are current as of this build.
ANTHROPIC_MODEL="claude-sonnet-5"
OPENAI_MODEL="gpt-4.1-mini"

# DeepSeek. Run `npm run ai:check` to list the model ids your account actually
# exposes — do not guess them. `-flash` is the right default for this workload:
# the model only rewrites a plan the deterministic layer already decided, so
# `-pro` buys reasoning depth that is never used. Swap to pro if Bangla prose
# quality matters more than latency and cost.
DEEPSEEK_MODEL="deepseek-v4-flash"
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"

# Chain of thought: disabled | adaptive | enabled. The API's own default is
# `adaptive`, which DOES think (measured: ~52-79 reasoning tokens per call, ~4x
# the output tokens, for identical answers). This product discards any trace
# unread, so it asks for `disabled` and drops one if it arrives anyway.
# `reasoning_effort: none` is NOT valid — turning it off is this setting.
DEEPSEEK_THINKING="disabled"
# Only has an effect when thinking is not disabled: low | medium | high | xhigh | max
# DEEPSEEK_REASONING_EFFORT="low"
# Escape hatch, merged last, only if the API changes:
# DEEPSEEK_EXTRA_BODY='{"thinking":{"type":"disabled"}}'
# Embeddings are only used when OPENAI_API_KEY is set; otherwise the
# retriever falls back to BM25 + token overlap (docs/DEVIATIONS.md §3).
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# ---------------------------------------------------------------
# OTP delivery — OPTIONAL.
# With no SMS provider configured, the OTP is written to the server log
# AND surfaced in the UI as a clearly-labelled dev affordance so the
# auth flow is completable. Never enable OTP_DEV_ECHO in production.
# ---------------------------------------------------------------
OTP_DEV_ECHO="true"
# SMS_PROVIDER="ssl_wireless"     # ssl_wireless | bulksmsbd | twilio
# SMS_API_KEY=""
# SMS_SENDER_ID=""

# ---------------------------------------------------------------
# National ID verification — OPTIONAL (Phase 1).
# With no provider configured, a National ID number is only format-checked
# and the result is labelled "simulated_verified" — never "verified". Naming
# a provider without an implementation fails loudly rather than silently
# reporting success (see modules/identity/nid.service.ts).
# ---------------------------------------------------------------
# NID_PROVIDER="porichoy"
# NID_API_KEY=""

# ---------------------------------------------------------------
# Voice — ALL OPTIONAL.
#
# Voice NAVIGATION needs no keys at all: intent resolution is deterministic
# phrase matching, so a browser with the Web Speech API drives the whole app
# with nothing configured here.
#
# These keys only add a SERVER-SIDE fallback for browsers whose Web Speech API
# is missing — which is most Android WebViews, i.e. any link opened inside
# Facebook or WhatsApp. With no key and no browser support, the microphone is
# disabled with a stated reason; transcription is never simulated, because an
# invented transcript would be acted on.
#
# The endpoint is the OpenAI-compatible /audio/transcriptions shape, so
# STT_BASE_URL points equally at a hosted vendor or your own whisper.cpp server.
# ---------------------------------------------------------------
# Which path handles speech:
#   auto     browser Web Speech where present, server otherwise (default)
#   server   ALWAYS record and upload — identical behaviour on every browser,
#            and no audio going to Google as a side effect of Web Speech
#   browser  never upload audio; Chromium only
# A "server" preference with no STT_API_KEY is reported as "auto" rather than
# leaving the citizen a microphone that can never work.
# VOICE_MODE="auto"

# WITHOUT ONE OF THE THREE BELOW, NOTHING IS HEARD IN ANY LANGUAGE.
# That is worth stating plainly because it presents as "Bangla voice does not
# work": in Firefox and Android WebViews there is no browser recogniser to fall
# back on, so the microphone is disabled with a reason. Bangla UNDERSTANDING is
# a separate layer that needs no key — check it with `npm run voice:bangla`.
#
# --- pick ONE. All three speak the same /audio/transcriptions shape, so only
# --- these three lines change between them. Verify with `npm run voice:check`.
#
# (a) Groq — FREE tier, ~2 minutes to set up, best Bangla accuracy per effort.
#     Sign up at console.groq.com, create a key, paste these three lines.
#     whisper-large-v3 is genuinely multilingual and handles Bangla well.
#     STT_API_KEY="gsk_..."
#     STT_BASE_URL="https://api.groq.com/openai/v1"
#     STT_MODEL="whisper-large-v3"
#
# (b) Self-hosted whisper.cpp — free, NO ACCOUNT, and no audio leaves your
#     machine. Best privacy, needs a few GB of model and a capable CPU/GPU.
#     Its bundled server already speaks this shape:
#       ./build/bin/whisper-server -m models/ggml-large-v3.bin --port 8080 --convert
#     STT_API_KEY="local-no-auth"
#     STT_BASE_URL="http://localhost:8080/v1"
#     STT_MODEL="whisper-1"
#
# (c) OpenAI directly — paid per minute, no free tier.
#     STT_API_KEY="sk-..."
#     STT_BASE_URL="https://api.openai.com/v1"
#     STT_MODEL="whisper-1"
#
# STT_PROMPT already defaults to a Bangla domain vocabulary (programme names,
# navigation words, টাকা/হাজার/লাখ). Whisper is English-heavy and will emit
# plausible English for Bangla audio without that hint. Extend it if you add
# programmes; do not blank it.
# Verify whichever you choose with:  npm run voice:check
# STT_API_KEY=""
# STT_BASE_URL="https://api.openai.com/v1"
# STT_MODEL="whisper-1"
# Vocabulary bias — cuts the mishearings that matter most:
# STT_PROMPT="বিধবা ভাতা, প্রতিবন্ধী ভাতা, বয়স্ক ভাতা, টাকা, উপজেলা, সমাজসেবা"

# Read-aloud only needs this when the device has no Bangla voice installed;
# otherwise the browser's own speechSynthesis is used, free and offline.
# TTS_API_KEY=""
# TTS_BASE_URL="https://api.openai.com/v1"
# TTS_MODEL="tts-1"
# TTS_VOICE="alloy"

# ---------------------------------------------------------------
# Maps — NO KEY NEEDED.
#
# The default is OpenStreetMap, which needs no account and no billing, so
# the map works on a fresh clone. Two things come from OSM:
#
#   • Map tiles, fetched through THIS app (/api/v1/map/tile/z/x/y) rather
#     than by the browser. That keeps the CSP at img-src 'self', lets us
#     send the identifying User-Agent OSM's tile policy requires, and means
#     the tile host never sees which citizen is looking up a legal-aid
#     office.
#
#   • Real places — hospitals, police stations, courts, pharmacies, banks,
#     post offices, fire stations — via the Overpass API, cached in the
#     `osm_place_cache` table. These are shown ALONGSIDE the authored
#     sample records and are labelled separately; the two are never merged.
#
# Set NEXT_PUBLIC_MAP_PROVIDER="none" to switch both off. The screen then
# falls back to the seeded distance-sorted list and says why.
#
# IMPORTANT for anything beyond a prototype: OSM's tile and Overpass
# services are volunteer-run and rate-limited. Point MAP_TILE_URL and
# OVERPASS_URL at your own cache or a paid provider before real traffic,
# and set MAP_USER_AGENT to something that identifies you and can be
# contacted. See docs/EXTERNAL.md.
# ---------------------------------------------------------------
NEXT_PUBLIC_MAP_PROVIDER="osm"         # osm | none | mapbox | google
# MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
# MAP_USER_AGENT="Shebar Janala/1.0 (contact: you@example.com)"
# OVERPASS_URL="https://overpass-api.de/api/interpreter"
# OVERPASS_CACHE_HOURS="336"           # 14 days
# OVERPASS_RADIUS_KM="25"

# Alternatives, if you would rather use a commercial provider.
# NEXT_PUBLIC_MAPBOX_TOKEN=""
# GOOGLE_MAPS_API_KEY=""

# ---------------------------------------------------------------
# Email (PRD §87 SMTP_*) — OPTIONAL.
# Unset = notifications are persisted and shown in-app only.
# ---------------------------------------------------------------
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM="Shebar Janala <no-reply@shebar-janala.gov.bd>"

# ---------------------------------------------------------------
# Object storage (PRD §87 S3_*) — OPTIONAL.
# Used by issue-report photo uploads (src/modules/issues/photo-storage.ts).
# Unset = photos are written to ./public/uploads/issues instead, which only
# works when the app has a writable local filesystem (not Cloudflare Workers).
# ---------------------------------------------------------------
# S3_BUCKET=""
# S3_REGION="auto"                                  # R2 accepts "auto"
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
# S3_ENDPOINT=""       # e.g. https://<account-id>.r2.cloudflarestorage.com
# S3_PUBLIC_URL=""     # the bucket's public r2.dev URL or custom domain

# ---------------------------------------------------------------
# App
# ---------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Shebar Janala"
NODE_ENV="development"

# Rate limiting (PRD §48). In-process token bucket; swap for Redis in prod.
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="120"
RATE_LIMIT_AI_MAX_REQUESTS="20"
# Audio is the most expensive input: a megabyte of upload and a per-minute
# charge per press. 30/min still allows continuous voice navigation.
RATE_LIMIT_VOICE_MAX_REQUESTS="30"
